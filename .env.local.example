# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Provider API Keys ─────────────────────────────────────────────────────────
# vast.ai  — https://vast.ai/console/account (API key in account settings)
VASTAI_API_KEY=YOUR_VASTAI_KEY

# RunPod   — https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=YOUR_RUNPOD_KEY

# Lambda Labs — https://cloud.lambdalabs.com/api-keys
LAMBDA_API_KEY=YOUR_LAMBDA_KEY

# AWS Pricing (no key needed — public JSON, but set region)
AWS_PRICING_REGION=us-east-1

# GCP Pricing (no key needed — public SKU API)
GCP_PROJECT_ID=YOUR_GCP_PROJECT   # optional, for authenticated quota

# CoreWeave — https://cloud.coreweave.com/api-access
COREWEAVE_API_KEY=YOUR_COREWEAVE_KEY

# Nebius — https://console.nebius.ai/
NEBIUS_API_KEY=YOUR_NEBIUS_KEY

# GMI Cloud — https://gmicloud.ai/console
GMI_API_KEY=YOUR_GMI_KEY

# Hyperstack — https://infrahub.nexgencloud.com/
HYPERSTACK_API_KEY=YOUR_HYPERSTACK_KEY

# FluidStack — https://platform.fluidstack.io
FLUIDSTACK_API_KEY=YOUR_FLUIDSTACK_KEY

# TensorDock — https://console.tensordock.com (no key needed for public listings)
# TENSORDOCK_API_KEY=YOUR_TENSORDOCK_KEY

# Voltage Park — https://voltagepark.com (contact sales for API access)
VOLTAGEPARK_API_KEY=YOUR_VOLTAGEPARK_KEY

# Crusoe — https://console.crusoe.ai/account/api-keys
CRUSOE_API_KEY=YOUR_CRUSOE_KEY

# ── Energy APIs ───────────────────────────────────────────────────────────────
# EIA (US Energy Info Admin) — free at https://www.eia.gov/opendata/
EIA_API_KEY=YOUR_EIA_KEY

# ENTSO-E (European grid) — free at https://transparency.entsoe.eu/
ENTSOE_API_KEY=YOUR_ENTSOE_KEY

# ── Cron / Security ───────────────────────────────────────────────────────────
# Secret to protect /api/cron/* routes (set same value in Vercel cron config)
CRON_SECRET=YOUR_RANDOM_SECRET_HERE

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
